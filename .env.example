# Copia este archivo a .env y ajusta lo que necesites.
# Lo lee el backend (server/) y también Vite (solo las variables VITE_*).
# .env está en .gitignore: no lo subas al repo.

# Puerto del servidor Node (por defecto 3001).
PORT=3001

# Archivo de la base de datos SQLite (por defecto data/agenda.db).
DB_FILE=data/agenda.db

# ── Interpretación con IA (opcional) ──
# Sin clave, la app usa el intérprete local (parsearLocal) y sigue siendo usable.
# La key se lee SOLO en el servidor y nunca llega al navegador.
ANTHROPIC_API_KEY=
# MODELO=claude-haiku-4-5-20251001

# ── Token opcional para proteger la API ──
# Si defines AGENDA_TOKEN, la API exige la cabecera X-Agenda-Token.
# VITE_AGENDA_TOKEN debe COINCIDIR con AGENDA_TOKEN (se compila en el frontend,
# así que es protección ligera; para seguridad real haría falta login).
AGENDA_TOKEN=
VITE_AGENDA_TOKEN=
